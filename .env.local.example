# Firebase client config (from Firebase console > Project settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Tournament admin dashboard (/admin). Comma-separated list of the Firebase
# Auth email(s) allowed to sign in there. Defaults to "njcarlo@gmail.com" when
# unset — set this explicitly for other deployments.
LEADERBOARD_ADMIN_EMAILS=
